meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{url}}/auth/login
  body: formUrlEncoded
  auth: none
}

body:json {
  {
    "email": {{user_email}},
    "password": {{user_password}}
  }
}

body:form-urlencoded {
  email: {{user_email}}
  password: {{user_password}}
}

script:post-response {
  const body = res.getBody()
  bru.setEnvVar("token", body.token)
}
